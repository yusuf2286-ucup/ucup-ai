{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing authentication info and account state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "AppIdea": {
      "title": "AppIdea",
      "description": "An application idea generated by AI or formulated by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 80 },
        "targetAudience": { "type": "string", "maxLength": 500 },
        "techStack": { "type": "string", "maxLength": 500 },
        "keyFeatures": { "type": "string", "maxLength": 2000 },
        "monetization": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "isFavorite": { "type": "boolean" },
        "tags": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 4000 },
        "aiAnalysis": { "type": "string", "maxLength": 8000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "summary", "category", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "System admin verification entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "maxLength": 50 },
        "assignedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing user profile settings"
    },
    "/users/{userId}/ideas/{ideaId}": {
      "schema": "AppIdea",
      "description": "User specific app ideas with complete metadata and AI analysis"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Admins registry for privilege checking"
    }
  }
}
