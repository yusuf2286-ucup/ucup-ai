rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mhmmdyusf2286@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validasi data profil pengguna
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    // Validasi data ide aplikasi
    function isValidAppIdea(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    // 1. Dokumen Profil Pengguna: Hanya pemilik (userId) yang dapat membaca dan menulis
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == userId;
      allow update: if (isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // 2. Sub-koleksi Ide Aplikasi Pengguna: Setiap user HANYA bisa membaca/menulis datanya sendiri
      match /ideas/{ideaId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                         isValidId(ideaId) &&
                         isValidAppIdea(request.resource.data) &&
                         request.resource.data.userId == userId;
        allow update: if (isOwner(userId) &&
                          isValidId(ideaId) &&
                          isValidAppIdea(request.resource.data) &&
                          request.resource.data.userId == userId &&
                          request.resource.data.userId == resource.data.userId) ||
                         isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // 3. Sub-koleksi kustom lainnya milik pengguna
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Koleksi registry Admin
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
